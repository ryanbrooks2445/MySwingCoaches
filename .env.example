# Next.js web app (copy to .env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional: override Stripe Checkout header + card statement text (defaults to ForeFixed)
STRIPE_CHECKOUT_DISPLAY_NAME=
STRIPE_CHECKOUT_STATEMENT_DESCRIPTOR=

# Production rate limiting (required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Monitoring (optional locally; recommended in production)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Analytics (optional — omit to disable)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Support email alerts via Resend (optional locally; recommended in production)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPPORT_INBOX_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
