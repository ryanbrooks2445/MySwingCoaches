# Next.js web app (copy to .env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional: override Stripe Checkout header + card statement text (defaults to ForeFixed)
STRIPE_CHECKOUT_DISPLAY_NAME=
STRIPE_CHECKOUT_STATEMENT_DESCRIPTOR=

# Production rate limiting and monitoring
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
